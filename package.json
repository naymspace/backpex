{
  "name": "backpex",
  "version": "0.18.0",
  "license": "MIT",
  "type": "module",
  "main": "./priv/static/js/backpex.cjs.js",
  "module": "./priv/static/js/backpex.esm.js",
  "exports": {
    "import": {
      "default": "./priv/static/js/backpex.esm.js"
    },
    "require": {
      "default": "./priv/static/js/backpex.cjs.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/naymspace/backpex.git"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "package.json",
    "priv/static/js/*",
    "assets/js/**"
  ],
  "scripts": {
    "format:standard": "standard assets/js test/js integration_test/e2e/assets --fix",
    "lint:standard": "standard assets/js test/js integration_test/e2e/assets",
    "test:js": "bun test test/js",
    "e2e:assets": "bun build integration_test/e2e/assets/app.js --outdir tmp/e2e/assets && tailwindcss --input integration_test/e2e/assets/app.css --output tmp/e2e/assets/app.css",
    "e2e:install": "playwright install chromium --with-deps --only-shell"
  },
  "standard": {
    "globals": [
      "localStorage",
      "sessionStorage",
      "IntersectionObserver",
      "requestAnimationFrame",
      "getComputedStyle"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",
    "heroicons": "2.2.0",
    "playwright": "1.64.1",
    "standard": "17.1.2",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "imask": "7.6.1"
  }
}
